---
import { products } from '../data/products';
import { farms } from '../data/origin';

const featured = products[0];
const farm = farms[0];
const strip = ['Cosecha selectiva', 'Fermentación controlada', 'Tueste semanal', 'Trazabilidad total'];
---

<section id="inicio" class="hero">
	<div class="container grid">
		<div class="copy">
			<p class="eyebrow">Café de especialidad · Colombia</p>
			<h1>
				Del filo de la montaña<br />
				<em>a tu taza.</em>
			</h1>
			<p class="lead">
				Cuatro lotes de altura cultivados entre 1.450 y 1.950 metros. Compramos directo a familias
				caficultoras, tostamos cada semana y despachamos con la fecha de tueste en la bolsa.
			</p>

			<div class="actions">
				<a class="button" href="#catalogo">Explorar catálogo</a>
				<a class="text-link" href="#origen">Conocer el origen</a>
			</div>

			<dl class="metrics">
				<div>
					<dt>Altitud</dt>
					<dd>1.450–1.950 <span>msnm</span></dd>
				</div>
				<div>
					<dt>Lotes</dt>
					<dd>04 <span>orígenes</span></dd>
				</div>
				<div>
					<dt>Tueste</dt>
					<dd>Semanal <span>12 kg</span></dd>
				</div>
			</dl>
		</div>

		<aside class="lot" aria-label="Lote destacado">
			<div class="lot-top">
				<span class="dot" aria-hidden="true"></span>
				<span>Lote de la semana · {farm.lot}</span>
			</div>

			<div class="lot-body">
				<p class="lot-label">Finca</p>
				<p class="lot-farm">{featured.farm.replace('Finca ', '')}</p>

				<dl class="lot-specs">
					<div><dt>Región</dt><dd>{featured.region}</dd></div>
					<div><dt>Altitud</dt><dd>{featured.altitude.toLocaleString('es-CO')} msnm</dd></div>
					<div><dt>Proceso</dt><dd>{featured.process}</dd></div>
					<div><dt>Varietal</dt><dd>{featured.varietal}</dd></div>
				</dl>

				<ul class="lot-notes">
					{featured.notes.map((note) => <li>{note}</li>)}
				</ul>
			</div>

			<p class="stamp" aria-hidden="true">Tostado en lotes de 12 kg</p>
		</aside>
	</div>

	<div class="strip">
		<div class="container strip-inner">
			{strip.map((item, index) => (
				<span class="strip-item">
					{item}
					{index < strip.length - 1 && <span class="sep" aria-hidden="true">·</span>}
				</span>
			))}
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		background:
			radial-gradient(58rem 32rem at 88% -10%, rgba(168, 69, 31, 0.14), transparent 62%),
			var(--cream);
	}

	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: center;
		padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
	}

	.copy h1 {
		margin-top: 1.1rem;
		font-size: clamp(2.5rem, 6.4vw, 4.9rem);
	}

	.copy h1 em {
		font-style: italic;
		color: var(--clay);
	}

	.lead {
		max-width: 34rem;
		margin-top: 1.5rem;
		color: var(--ink-2);
		font-size: clamp(1rem, 0.96rem + 0.3vw, 1.12rem);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		margin-top: 2.1rem;
	}

	.button {
		display: inline-block;
		padding: 0.95rem 1.5rem;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: var(--radius);
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.button:hover {
		background: var(--clay);
		transform: translateY(-1px);
	}

	.text-link {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-2);
		border-bottom: 1px solid var(--line-strong);
		padding-bottom: 0.2rem;
		transition: color 0.2s ease;
	}

	.text-link:hover {
		color: var(--clay);
	}

	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 2.25rem;
		margin: 3rem 0 0;
		padding-top: 1.6rem;
		border-top: 1px solid var(--line);
	}

	.metrics dt {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.metrics dd {
		margin: 0.3rem 0 0;
		font-family: var(--font-display);
		font-size: 1.28rem;
	}

	.metrics dd span {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.lot {
		position: relative;
		padding: clamp(1.5rem, 3vw, 2.35rem);
		background:
			radial-gradient(26rem 18rem at 100% 0%, rgba(184, 132, 47, 0.22), transparent 60%),
			var(--ink);
		color: var(--cream);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.lot-top {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(246, 239, 227, 0.62);
	}

	.dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: var(--gold);
	}

	.lot-body {
		margin-top: clamp(2.5rem, 6vw, 4rem);
	}

	.lot-label {
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgba(246, 239, 227, 0.5);
	}

	.lot-farm {
		margin-top: 0.35rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.9rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.lot-specs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem 1.5rem;
		margin: 1.9rem 0 0;
		padding-top: 1.4rem;
		border-top: 1px solid rgba(246, 239, 227, 0.16);
	}

	.lot-specs dt {
		font-family: var(--font-mono);
		font-size: 0.56rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgba(246, 239, 227, 0.48);
	}

	.lot-specs dd {
		margin: 0.2rem 0 0;
		font-size: 0.92rem;
		color: rgba(246, 239, 227, 0.92);
	}

	.lot-notes {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 1.7rem 0 0;
		padding: 0;
		list-style: none;
	}

	.lot-notes li {
		padding: 0.28rem 0.7rem;
		border: 1px solid rgba(246, 239, 227, 0.22);
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(246, 239, 227, 0.82);
	}

	.stamp {
		width: 5.9rem;
		height: 5.9rem;
		display: grid;
		place-items: center;
		margin: 1.7rem 0 0 auto;
		padding: 0.9rem;
		border: 1px dashed rgba(246, 239, 227, 0.34);
		border-radius: 50%;
		transform: rotate(-9deg);
		font-family: var(--font-mono);
		font-size: 0.5rem;
		line-height: 1.45;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-align: center;
		color: rgba(246, 239, 227, 0.66);
	}

	.strip {
		border-block: 1px solid var(--line);
		background: rgba(237, 224, 204, 0.42);
	}

	.strip-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.1rem;
		padding-block: 0.85rem;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--ink-3);
	}

	.strip-item {
		display: inline-flex;
		align-items: center;
		gap: 1.1rem;
	}

	.sep {
		color: var(--gold);
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.lot {
			max-width: 34rem;
		}

		.stamp {
			width: 5.6rem;
			height: 5.6rem;
		}
	}

	@media (max-width: 560px) {
		.metrics {
			gap: 1.4rem;
		}

		.lot-body {
			margin-top: 2rem;
		}

		.stamp {
			display: none;
		}
	}
</style>
