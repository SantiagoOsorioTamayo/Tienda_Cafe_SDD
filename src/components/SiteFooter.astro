---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container top">
		<div class="brand">
			<p class="wordmark">{site.name}</p>
			<p class="tagline">{site.tagline}</p>
			<p class="pitch">
				Café de especialidad colombiano, tostado en lotes pequeños y enviado con fecha de tueste.
			</p>
		</div>

		<nav class="col" aria-label="Tienda">
			<p class="col-title">Tienda</p>
			<a href="#catalogo">Catálogo</a>
			<a href="#origen">Origen</a>
			<a href="#pedido">Pedidos</a>
		</nav>

		<div class="col">
			<p class="col-title">Contacto</p>
			<a href={`https://wa.me/${site.whatsapp}`}>WhatsApp</a>
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<p class="plain">{site.city}</p>
			<p class="plain">{site.hours}</p>
		</div>
	</div>

	<div class="container bottom">
		<p>© {year} {site.name} · Precios en COP</p>
		<p>Hecho en Colombia · Datos de ejemplo</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--ink);
		color: var(--cream);
		padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
		border-top: 1px solid rgba(184, 132, 47, 0.35);
	}

	.top {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 0.8fr));
		gap: clamp(2rem, 5vw, 4rem);
		padding-bottom: 2.5rem;
	}

	.wordmark {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.8rem);
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.tagline {
		margin-top: 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.pitch {
		max-width: 24rem;
		margin-top: 1.1rem;
		font-size: 0.88rem;
		color: rgba(246, 239, 227, 0.62);
	}

	.col {
		display: grid;
		align-content: start;
		gap: 0.5rem;
	}

	.col-title {
		margin-bottom: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.58rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: rgba(246, 239, 227, 0.42);
	}

	.col a {
		font-size: 0.88rem;
		text-decoration: none;
		color: rgba(246, 239, 227, 0.86);
		transition: color 0.2s ease;
	}

	.col a:hover {
		color: var(--gold);
	}

	.plain {
		font-size: 0.84rem;
		color: rgba(246, 239, 227, 0.55);
	}

	.bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem;
		padding-top: 1.4rem;
		border-top: 1px solid rgba(246, 239, 227, 0.14);
	}

	.bottom p {
		font-family: var(--font-mono);
		font-size: 0.56rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(246, 239, 227, 0.42);
	}

	@media (max-width: 820px) {
		.top {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
